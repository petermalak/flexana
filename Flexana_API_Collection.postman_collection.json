{
	"info": {
		"_postman_id": "flexana-api-collection",
		"name": "Flexana API Collection",
		"description": "Complete API collection for Flexana backend - Compatible with Emilia frontend format. Uses API Key + HMAC Signature authentication.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Generate API signature for authentication",
					"const keyId = pm.collectionVariables.get('api_key_id');",
					"const secretKey = pm.collectionVariables.get('api_secret_key');",
					"",
					"if (!keyId || !secretKey) {",
					"    console.warn('API key ID or secret key not set in collection variables');",
					"    return;",
					"}",
					"",
					"// Get request details",
					"const method = pm.request.method;",
					"const url = pm.request.url;",
					"const path = url.getPath();",
					"const queryString = url.getQueryString() || '';",
					"const body = pm.request.body ? pm.request.body.toString() : '';",
					"",
					"// Generate timestamp",
					"const timestamp = Math.floor(Date.now() / 1000);",
					"",
					"// Calculate body hash",
					"const bodyHash = CryptoJS.SHA256(body || '').toString();",
					"",
					"// Build string to sign",
					"const stringToSign = [",
					"    method.toUpperCase(),",
					"    path,",
					"    queryString,",
					"    timestamp.toString(),",
					"    bodyHash",
					"].join('\\n');",
					"",
					"// Generate HMAC signature",
					"const signature = CryptoJS.HmacSHA256(stringToSign, secretKey).toString();",
					"",
					"// Set headers",
					"pm.request.headers.add({",
					"    key: 'X-API-Key',",
					"    value: keyId",
					"});",
					"pm.request.headers.add({",
					"    key: 'X-API-Signature',",
					"    value: signature",
					"});",
					"pm.request.headers.add({",
					"    key: 'X-API-Timestamp',",
					"    value: timestamp.toString()",
					"});",
					"",
					"// Remove old Firebase auth header if present",
					"pm.request.headers.remove('Authorization');"
				]
			}
		}
	],
