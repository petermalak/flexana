		{
			"name": "Promo Code Flow",
			"description": "Promo codes apply a percentage discount. Verify a code first: POST /api/v1/promo-codes/verify (body: code). Then pass promoCode when booking a session or purchasing a package. Codes are case-sensitive; invalid/expired codes are ignored (full price charged). Managed in Filament Admin → Promo Codes.",
			"item": [
				{
					"name": "Verify Promo Code",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"code\": \"SAVE20\"\n}"
						},
						"url": { "raw": "{{base_url}}/api/v1/promo-codes/verify", "host": ["{{base_url}}"], "path": ["api", "v1", "promo-codes", "verify"] },
						"description": "Check if a promo code exists and is valid for the current customer. Body: code (required). Returns valid (boolean), reason (not_found | inactive | not_yet_valid | expired | usage_limit_reached), message, and when valid or when code exists: promo_code (id, code, name, percent_discount, valid_from, valid_until, usage_limit_per_user, uses_by_you, used_count_total, is_active). Requires Bearer."
					},
					"response": [
						{ "name": "Valid", "status": "OK", "code": 200, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": "{\"valid\":true,\"message\":\"Promo code is valid.\",\"promo_code\":{\"id\":1,\"code\":\"SAVE20\",\"name\":\"Summer Sale\",\"percent_discount\":20,\"valid_from\":null,\"valid_until\":\"2025-12-31T23:59:59+00:00\",\"usage_limit_per_user\":1,\"uses_by_you\":0,\"used_count_total\":42,\"is_active\":true}}" },
						{ "name": "Not found", "status": "OK", "code": 200, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": "{\"valid\":false,\"reason\":\"not_found\",\"message\":\"Promo code does not exist.\"}" }
					]
				},
				{
					"name": "Book Session (with promo code)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"sessionID\": 1,\n    \"persons\": 1,\n    \"promoCode\": \"SAVE10\",\n    \"isDropIn\": true\n}"
						},
						"url": { "raw": "{{base_url}}/api/v1/session-bookings", "host": ["{{base_url}}"], "path": ["api", "v1", "session-bookings"] },
						"description": "Apply a promo code when booking a session. Replace SAVE10 with a valid code from Admin. Valid code applies percent discount; invalid/expired code is ignored (booking succeeds at full price). Use isDropIn: true for drop-in (no package) or false to deduct from package. Response includes isDropIn. Requires Bearer."
