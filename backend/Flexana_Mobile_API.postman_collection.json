{
	"info": {
		"_postman_id": "flexana-mobile-api-v1",
		"name": "Flexana Mobile API (v1)",
		"description": "API collection for Flexana mobile app. All data endpoints require Bearer token (get from Auth → Verify). Base: /api/v1",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{bearer_token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Auth",
			"description": "Public: send-code, verify. After Verify, use the returned token as Bearer for all other requests.",
			"item": [
				{
					"name": "Send Code",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"phone\": \"+201234567890\",\n    \"firstName\": \"Jane\",\n    \"lastName\": \"Doe\",\n    \"email\": \"jane@example.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/send-code",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "send-code"]
						},
						"description": "Send SMS verification code. Optional: firstName, lastName, email."
					},
					"response": []
				},
				{
					"name": "Verify",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"if (res.token) {",
									"    pm.collectionVariables.set('bearer_token', res.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"phone\": \"+201234567890\",\n    \"code\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/verify",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "verify"]
						},
						"description": "Verify code and get token. Saves token to collection variable bearer_token for other requests."
					},
					"response": [
						{
							"name": "Success",
							"originalRequest": {
								"method": "POST",
								"header": [{"key": "Content-Type", "value": "application/json"}],
								"body": {"mode": "raw", "raw": "{\n    \"phone\": \"+201234567890\",\n    \"code\": \"123456\"\n}"},
								"url": {"raw": "{{base_url}}/api/v1/auth/verify", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "verify"]}
							},
							"status": "OK",
							"code": 200,
							"header": [{"key": "Content-Type", "value": "application/json"}],
							"body": "{\n    \"success\": true,\n    \"message\": \"Verified.\",\n    \"token\": \"1|abc...\",\n    \"token_type\": \"Bearer\",\n    \"customer\": {\n        \"id\": \"1\",\n        \"uid\": \"uuid\",\n        \"firstName\": \"Jane\",\n        \"lastName\": \"Doe\",\n        \"email\": \"jane@example.com\",\n        \"phone\": \"+201234567890\",\n        \"phoneVerifiedAt\": \"2024-01-20T12:00:00.000000Z\",\n        \"emailVerifiedAt\": null\n    }\n}"
						}
					]
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/auth/logout",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "logout"]
						},
						"description": "Revoke current token. Requires Bearer."
					},
					"response": []
				},
				{
					"name": "Get Me",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/auth/me",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "me"]
						},
						"description": "Current customer profile. Requires Bearer."
					},
					"response": []
				},
				{
					"name": "Update Me",
					"request": {
						"method": "PUT",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"firstName\": \"Jane\",\n    \"lastName\": \"Doe\",\n    \"email\": \"jane@example.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/me",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "me"]
						},
						"description": "Update profile. Requires Bearer."
					},
					"response": []
				}
			]
		},
		{
			"name": "Home Screen",
			"item": [
				{
					"name": "Get Banners",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/banners",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "banners"]
						},
						"description": "Response: [{ image, URL }, ...]. Requires Bearer."
					},
					"response": [
						{
							"name": "Success",
							"originalRequest": {
								"method": "GET",
								"url": {"raw": "{{base_url}}/api/v1/banners", "host": ["{{base_url}}"], "path": ["api", "v1", "banners"]}
							},
							"status": "OK",
							"code": 200,
							"header": [{"key": "Content-Type", "value": "application/json"}],
							"body": "[\n    {\n        \"image\": \"https://example.com/banner1.jpg\",\n        \"URL\": \"https://example.com/promo1\"\n    }\n]"
						}
					]
				},
				{
					"name": "Get Instructors (Full)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/instructors",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "instructors"]
						},
						"description": "Response: [{ id, name, image, position, brief }, ...]. Requires Bearer."
					},
					"response": [
						{
							"name": "Success",
							"originalRequest": {
								"method": "GET",
								"url": {"raw": "{{base_url}}/api/v1/instructors", "host": ["{{base_url}}"], "path": ["api", "v1", "instructors"]}
							},
							"status": "OK",
							"code": 200,
							"header": [{"key": "Content-Type", "value": "application/json"}],
							"body": "[\n    {\n        \"id\": \"1\",\n        \"name\": \"John Doe\",\n        \"image\": \"https://example.com/instructor1.jpg\",\n        \"position\": \"Senior Yoga Instructor\",\n        \"brief\": \"10 years of experience\"\n    }\n]"
						}
					]
				},
				{
					"name": "Get Service (Full)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/service",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "service"]
						},
						"description": "Response: [{ id, name, level, image, brief }, ...]. Requires Bearer."
					},
					"response": [
						{
							"name": "Success",
							"originalRequest": {
								"method": "GET",
								"url": {"raw": "{{base_url}}/api/v1/service", "host": ["{{base_url}}"], "path": ["api", "v1", "service"]}
							},
							"status": "OK",
							"code": 200,
							"header": [{"key": "Content-Type", "value": "application/json"}],
							"body": "[\n    {\n        \"id\": \"1\",\n        \"name\": \"Yoga Class\",\n        \"level\": \"Beginner\",\n        \"image\": \"https://example.com/service1.jpg\",\n        \"brief\": \"A relaxing yoga class\"\n    }\n]"
						}
					]
				}
			],
			"description": "APIs for the home screen. All require Authorization: Bearer <token>."
		},
		{
			"name": "Schedule Screen",
			"item": [
				{
					"name": "Get Instructors (Simple)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/instructors/simple",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "instructors", "simple"]
						},
						"description": "Response: [{ id, name }, ...]. Requires Bearer."
					},
					"response": [
						{
							"name": "Success",
							"originalRequest": {
								"method": "GET",
								"url": {"raw": "{{base_url}}/api/v1/instructors/simple", "host": ["{{base_url}}"], "path": ["api", "v1", "instructors", "simple"]}
							},
							"status": "OK",
							"code": 200,
							"header": [{"key": "Content-Type", "value": "application/json"}],
							"body": "[{\"id\": \"1\", \"name\": \"John Doe\"}]"
						}
					]
				},
				{
					"name": "Get Service (Simple)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/service/simple",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "service", "simple"]
						},
						"description": "Response: [{ id, name }, ...]. Requires Bearer."
					},
					"response": [
						{
							"name": "Success",
							"originalRequest": {
								"method": "GET",
								"url": {"raw": "{{base_url}}/api/v1/service/simple", "host": ["{{base_url}}"], "path": ["api", "v1", "service", "simple"]}
							},
							"status": "OK",
							"code": 200,
							"header": [{"key": "Content-Type", "value": "application/json"}],
							"body": "[{\"id\": \"1\", \"name\": \"Yoga Class\"}]"
						}
					]
				},
				{
					"name": "Get Sessions",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/sessions?date=2024-01-20&serviceID=1&instructorID=1",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "sessions"],
							"query": [
								{"key": "date", "value": "2024-01-20", "description": "YYYY-MM-DD"},
								{"key": "serviceID", "value": "1", "description": "Optional"},
								{"key": "instructorID", "value": "1", "description": "Optional"}
							]
						},
						"description": "Query: date, serviceID, instructorID. Response: [{ id, instructor, service, date, isBooked, isFull, canCancel, canBook, minutesBeforeCancellation }, ...]. Requires Bearer."
					},
					"response": [
						{
							"name": "Success",
							"originalRequest": {
								"method": "GET",
								"url": {"raw": "{{base_url}}/api/v1/sessions?date=2024-01-20&serviceID=1&instructorID=1", "host": ["{{base_url}}"], "path": ["api", "v1", "sessions"], "query": [{"key": "date", "value": "2024-01-20"}, {"key": "serviceID", "value": "1"}, {"key": "instructorID", "value": "1"}]}
							},
							"status": "OK",
							"code": 200,
							"header": [{"key": "Content-Type", "value": "application/json"}],
							"body": "[\n    {\n        \"id\": \"1\",\n        \"instructor\": \"John Doe\",\n        \"service\": \"Yoga Class\",\n        \"date\": \"2024-01-20T10:00:00.000000Z\",\n        \"isBooked\": false,\n        \"isFull\": false,\n        \"canCancel\": false,\n        \"canBook\": true,\n        \"minutesBeforeCancellation\": 60\n    }\n]"
						}
					]
				},
				{
					"name": "Book Session",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"sessionID\": 1,\n    \"persons\": 1\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/session-bookings",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "session-bookings"]
						},
						"description": "Book one session using sessionID. Customer from Bearer token. Optional: persons (default 1). Requires Bearer."
					},
					"response": [
						{
							"name": "Success",
							"originalRequest": {
								"method": "POST",
								"header": [{"key": "Content-Type", "value": "application/json"}],
								"body": {"mode": "raw", "raw": "{\n    \"sessionID\": 1,\n    \"persons\": 1\n}"},
								"url": {"raw": "{{base_url}}/api/v1/session-bookings", "host": ["{{base_url}}"], "path": ["api", "v1", "session-bookings"]}
							},
							"status": "Created",
							"code": 201,
							"header": [{"key": "Content-Type", "value": "application/json"}],
							"body": "{\n    \"success\": true,\n    \"message\": \"Booking created successfully\",\n    \"data\": {\n        \"id\": \"1\",\n        \"sessionID\": \"1\",\n        \"customerId\": \"1\"\n    }\n}"
						}
					]
				},
				{
					"name": "Cancel Booking",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"sessionID\": 1,\n    \"customerBookingId\": 1\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/cancel-booking",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "cancel-booking"]
						},
						"description": "Cancel one booking using sessionID. Optional: customerBookingId. Requires Bearer."
					},
					"response": [
						{
							"name": "Success",
							"originalRequest": {
								"method": "POST",
								"header": [{"key": "Content-Type", "value": "application/json"}],
								"body": {"mode": "raw", "raw": "{\n    \"sessionID\": 1,\n    \"customerBookingId\": 1\n}"},
								"url": {"raw": "{{base_url}}/api/v1/cancel-booking", "host": ["{{base_url}}"], "path": ["api", "v1", "cancel-booking"]}
							},
							"status": "OK",
							"code": 200,
							"header": [{"key": "Content-Type", "value": "application/json"}],
							"body": "{\n    \"success\": true,\n    \"message\": \"Booking canceled successfully\"\n}"
						}
					]
				}
			],
			"description": "APIs for the schedule screen. All require Bearer token."
		},
		{
			"name": "Packages Screen",
			"item": [
				{
					"name": "Get Package Offers",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/package-offers",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "package-offers"]
						},
						"description": "Response: [{ id, name, price, sessions, description, expirationMonths }, ...]. Requires Bearer."
					},
					"response": [
						{
							"name": "Success",
							"originalRequest": {
								"method": "GET",
								"url": {"raw": "{{base_url}}/api/v1/package-offers", "host": ["{{base_url}}"], "path": ["api", "v1", "package-offers"]}
							},
							"status": "OK",
							"code": 200,
							"header": [{"key": "Content-Type", "value": "application/json"}],
							"body": "[\n    {\n        \"id\": 1,\n        \"name\": \"Monthly Package\",\n        \"price\": 99.99,\n        \"sessions\": 10,\n        \"description\": \"10 sessions valid for 1 month\",\n        \"expirationMonths\": 1\n    }\n]"
						}
					]
				},
				{
					"name": "Purchase Package",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"packageId\": 1\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/purchase-package",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "purchase-package"]
						},
						"description": "Purchase one package. Customer from Bearer token. Body: packageId only. Requires Bearer."
					},
					"response": [
						{
							"name": "Success",
							"originalRequest": {
								"method": "POST",
								"header": [{"key": "Content-Type", "value": "application/json"}],
								"body": {"mode": "raw", "raw": "{\n    \"packageId\": 1\n}"},
								"url": {"raw": "{{base_url}}/api/v1/purchase-package", "host": ["{{base_url}}"], "path": ["api", "v1", "purchase-package"]}
							},
							"status": "Created",
							"code": 201,
							"header": [{"key": "Content-Type", "value": "application/json"}],
							"body": "{\n    \"success\": true,\n    \"message\": \"Package purchased successfully\",\n    \"data\": {\n        \"id\": \"1\",\n        \"packageId\": \"1\",\n        \"customerId\": \"1\"\n    }\n}"
						}
					]
				}
			],
			"description": "APIs for the packages screen. All require Bearer token."
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000",
			"type": "string"
		},
		{
			"key": "bearer_token",
			"value": "",
			"type": "string"
		}
	]
}
