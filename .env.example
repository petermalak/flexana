APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# APP_TIMEZONE: primary Laravel/Carbon zone (default Africa/Cairo for Egypt-local MySQL datetimes).
# Mobile JSON still uses UTC ISO-8601 for instants where code uses ApiDateTime::toUtcIso8601() or ->utc()->toIso8601String().
APP_TIMEZONE=Africa/Cairo

# SMS (SMS Misr — mobile verification codes). Use SMS_DRIVER=log to log codes only.
SMS_DRIVER=log
SMSMISR_USERNAME=
SMSMISR_PASSWORD=
SMSMISR_SENDER_ID=
# 1 = Live, 2 = Test (SMS Misr API)
SMSMISR_ENVIRONMENT=1
# 1 = English, 2 = Arabic, 3 = Unicode (Bulk SMS only)
SMSMISR_LANGUAGE=1
SMSMISR_API_URL=https://smsmisr.com/api/SMS/

# OTP API (optional). When SMSMISR_OTP_TEMPLATE is set, OTP API is preferred over Bulk SMS.
SMSMISR_OTP_API_URL=https://smsmisr.com/api/OTP/
SMSMISR_OTP_TEMPLATE=

# Temporary workaround: allow POST /api/v1/auth/verify to perform password reset when password fields are present.
# The correct endpoint for password reset is POST /api/v1/auth/reset-password.
VERIFY_PASSWORD_RESET_WORKAROUND=false

# Public website schedule (GET /api/v1/web-sessions) — no Bearer token.
# Rate-limited per IP. Optionally restrict callers by IP/CIDR (comma-separated).
WEB_SCHEDULE_ENABLED=true
WEB_SCHEDULE_ALLOWED_IPS=
WEB_SCHEDULE_PER_MINUTE=120

# Comma-separated origins allowed to embed /web-session-bookings in an iframe
# Note: origins include scheme + host + port. For local dev, include http://127.0.0.1:8000 etc.
BOOKING_EMBED_FRAME_ANCESTORS="https://flexanaegypt.com,https://www.flexanaegypt.com,http://localhost,http://127.0.0.1,http://localhost:8000,http://127.0.0.1:8000"

# Optional: server-side palette extraction for /web-session-bookings (fetches HTML + linked CSS)
BOOKING_PALETTE_SOURCE_URL="http://localhost/Flexana/"
BOOKING_PALETTE_SOURCE_HOSTS="localhost,127.0.0.1,flexanaegypt.com,www.flexanaegypt.com"
BOOKING_PALETTE_MAX_STYLESHEETS=6

# After Paymob result redirect user back to WordPress schedule page
BOOKING_PAYMENT_SUCCESS_REDIRECT_URL="https://flexanaegypt.com/schedule-yoga-classes-book-now-new-cairo/"
BOOKING_PAYMENT_FAILED_REDIRECT_URL="https://flexanaegypt.com/schedule-yoga-classes-book-now-new-cairo/"

# Paymob (card payments) for /web-session-bookings drop-in payments
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_CURRENCY=EGP